# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key

# Server
PORT=3000
NODE_ENV=development

# Local SQLite storage
CALL_STORE_PATH=./data/calls.sqlite

# Audit Settings
AUDIT_MAX_TOKENS=2000
AUDIT_MODEL=claude-sonnet-4-20250514

# Voice Agent (Retell.ai)
# VOICE_MODEL is passed to Retell when creating a call session.
VOICE_MODEL=claude-sonnet-4-20250514

# Retell API key used to verify incoming webhook signatures.
RETELL_API_KEY=your_retell_api_key

# Retell number used to place outbound audit calls.
RETELL_FROM_NUMBER=+15551234567

# Optional Retell agent override for audit calls.
RETELL_AGENT_ID=your_retell_agent_id

# Optional public URL for local webhook testing with ngrok or a deployed app.
PUBLIC_BASE_URL=https://your-public-url.example

# Optional SMTP delivery for sending completed report workbooks.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="AI Business Audit <audit@example.com>"
