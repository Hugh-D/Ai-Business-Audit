# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Server
PORT=3000
NODE_ENV=development

# Audit Settings
AUDIT_MAX_TOKENS=2000
AUDIT_MODEL=claude-sonnet-4-20250514

# Voice Agent
# VOICE_MODEL is passed to the telephony/real-time layer — set to whichever
# Claude model your voice provider supports.
VOICE_MODEL=claude-sonnet-4-20250514
# Audio transcription requires a third-party service (AssemblyAI, Deepgram, etc.)
# TRANSCRIPTION_SERVICE_API_KEY=
